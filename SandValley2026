<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sand Valley Golf Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --green: #1a3a2a;
    --green-mid: #2d5a3d;
    --green-light: #3d7a52;
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --cream: #f5f0e8;
    --cream-dark: #ede5d5;
    --white: #ffffff;
    --text: #1a1a1a;
    --text-muted: #5a5a5a;
    --red: #8b2020;
    --border: rgba(0,0,0,0.12);
    --radius: 10px;
    --radius-lg: 16px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--green);
    color: var(--text);
    min-height: 100vh;
  }

  /* HEADER */
  .header {
    background: var(--green);
    padding: 1.5rem 1.5rem 1rem;
    text-align: center;
    border-bottom: 2px solid var(--gold);
  }
  .header h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.8rem;
    color: var(--gold);
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .header p {
    color: var(--cream-dark);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* MAIN WRAPPER */
  .main {
    max-width: 780px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  /* SCREENS */
  .screen { display: none; }
  .screen.active { display: block; }

  /* CARDS */
  .card {
    background: var(--cream);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }
  .card-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  /* INPUTS */
  label { font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 4px; }
  input[type=text], input[type=number], select {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    background: var(--white);
    color: var(--text);
    outline: none;
    transition: border-color 0.15s;
  }
  input:focus, select:focus { border-color: var(--green-mid); }

  /* GRID HELPERS */
  .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  .g4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 8px; }

  /* BUTTONS */
  .btn {
    display: inline-block;
    padding: 10px 22px;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    color: var(--text);
    transition: all 0.15s;
  }
  .btn:hover { background: var(--cream-dark); }
  .btn-gold {
    background: var(--gold);
    color: var(--green);
    border-color: var(--gold);
    font-weight: 500;
  }
  .btn-gold:hover { background: var(--gold-light); border-color: var(--gold-light); }
  .btn-green {
    background: var(--green-mid);
    color: var(--cream);
    border-color: var(--green-mid);
  }
  .btn-green:hover { background: var(--green-light); border-color: var(--green-light); }
  .btn-sm { padding: 6px 12px; font-size: 12px; }
  .btn-full { width: 100%; text-align: center; }

  /* HOME SCREEN */
  .home-logo {
    text-align: center;
    padding: 2.5rem 0 2rem;
  }
  .home-logo .flag { font-size: 4rem; margin-bottom: 1rem; }
  .home-logo h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    color: var(--gold);
    letter-spacing: 0.1em;
  }
  .home-logo p { color: var(--cream-dark); font-size: 13px; margin-top: 6px; }
  .home-actions { display: grid; gap: 12px; }
  .home-btn {
    background: var(--cream);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .home-btn:hover { border-color: var(--gold); }
  .home-btn .icon { font-size: 2rem; }
  .home-btn h3 { font-size: 15px; font-weight: 500; color: var(--text); }
  .home-btn p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

  /* JOIN */
  .join-code-input {
    font-size: 2rem;
    text-align: center;
    letter-spacing: 0.3em;
    font-family: 'Bebas Neue', sans-serif;
    text-transform: uppercase;
  }

  /* ROUND CODE DISPLAY */
  .round-code-badge {
    background: var(--green);
    color: var(--gold);
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    letter-spacing: 0.3em;
    text-align: center;
    padding: 1rem;
    border-radius: var(--radius-lg);
    margin-bottom: 0.5rem;
  }
  .round-code-hint { font-size: 12px; color: var(--text-muted); text-align: center; }

  /* PLAYER BUILDER */
  .player-item {
    display: grid;
    grid-template-columns: 1fr 90px 90px 36px;
    gap: 8px;
    align-items: end;
    margin-bottom: 8px;
  }
  .chcp-display {
    background: var(--green);
    color: var(--gold);
    border-radius: var(--radius);
    padding: 9px 12px;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
  .remove-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 36px;
    height: 38px;
    cursor: pointer;
    font-size: 14px;
    color: var(--text-muted);
  }
  .remove-btn:hover { background: var(--cream-dark); color: var(--red); }

  /* HOLE HANDICAP GRID */
  .hi-grid {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 4px;
    margin-bottom: 6px;
  }
  .hi-cell { text-align: center; }
  .hi-cell label { font-size: 10px; text-align: center; }
  .hi-cell input { padding: 6px 2px; text-align: center; font-size: 13px; }

  /* SCORECARD */
  .scorecard-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 600px; }
  th {
    padding: 7px 4px;
    text-align: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th:first-child { text-align: left; }
  td {
    padding: 5px 4px;
    text-align: center;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  td:first-child { text-align: left; font-weight: 500; font-size: 12px; }
  td input[type=number] {
    width: 38px;
    padding: 4px 2px;
    text-align: center;
    font-size: 13px;
    border-radius: 6px;
  }
  .dot {
    display: inline-block;
    width: 5px; height: 5px;
    background: var(--green-mid);
    border-radius: 50%;
    vertical-align: super;
    margin-left: 1px;
  }
  .stroke-row td { background: rgba(0,0,0,0.03); font-size: 11px; color: var(--text-muted); }

  /* RESULTS */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap: 10px; margin-bottom: 1rem; }
  .metric { background: var(--green); border-radius: var(--radius); padding: 14px 12px; }
  .metric-label { font-size: 11px; color: #8fb89f; margin-bottom: 4px; }
  .metric-value { font-size: 1.6rem; font-family: 'Bebas Neue', sans-serif; color: var(--gold); letter-spacing: 0.05em; }
  .metric-sub { font-size: 11px; color: #8fb89f; }

  .result-table td.win { background: #d4edda; color: #1a5c2a; font-weight: 500; }
  .result-table td.halved { background: #f0f0f0; color: #666; }
  .result-table td.loss { background: #fde8e8; color: var(--red); }

  .match-hole-row {
    display: flex;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .match-hole-row .p1 { flex: 1; }
  .match-hole-row .hole-mid { width: 100px; text-align: center; color: var(--text-muted); font-size: 11px; }
  .match-hole-row .p2 { flex: 1; text-align: right; }
  .match-hole-row .win-name { font-weight: 500; color: var(--green-mid); }

  /* STATUS BAR */
  .status-bar {
    background: var(--green-mid);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 10px 16px;
    font-size: 13px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .status-dot { width: 8px; height: 8px; background: var(--gold); border-radius: 50%; animation: pulse 1.5s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* TABS */
  .tabs { display: flex; gap: 6px; margin-bottom: 1rem; }
  .tab {
    flex: 1;
    padding: 9px;
    text-align: center;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: var(--cream);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.15s;
  }
  .tab.active { background: var(--green); color: var(--gold); border-color: var(--green); }

  /* TOAST */
  .toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--green);
    color: var(--gold);
    padding: 12px 24px;
    border-radius: 999px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    opacity: 0;
    transition: all 0.3s;
    pointer-events: none;
    z-index: 999;
    border: 1px solid var(--gold);
    white-space: nowrap;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  .info-box {
    background: rgba(0,0,0,0.05);
    border-radius: var(--radius);
    padding: 10px 14px;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .divider { height: 1px; background: var(--border); margin: 1rem 0; }
  .mt { margin-top: 1rem; }
  .flex-end { display: flex; justify-content: flex-end; gap: 8px; }
  .flex-gap { display: flex; gap: 8px; flex-wrap: wrap; }

  .skin-winner { color: #1a5c2a; font-weight: 500; }
  .skin-carry { color: var(--text-muted); font-style: italic; }

  .back-link {
    color: var(--cream-dark);
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .back-link:hover { opacity: 1; }
</style>
</head>
<body>

<div class="header">
  <h1>Sand Valley</h1>
  <p>Golf Game Tracker</p>
</div>

<div class="main">

  <!-- HOME -->
  <div id="screen-home" class="screen active">
    <div class="home-logo">
      <div class="flag">⛳</div>
      <h2>Game Tracker</h2>
      <p>Skins &amp; match play with handicaps</p>
    </div>
    <div class="home-actions">
      <div class="home-btn" onclick="showScreen('screen-new')">
        <div class="icon">🏌️</div>
        <div>
          <h3>Start new round</h3>
          <p>Set up course, players and game type</p>
        </div>
      </div>
      <div class="home-btn" onclick="showScreen('screen-join')">
        <div class="icon">🔗</div>
        <div>
          <h3>Join a round</h3>
          <p>Enter a round code to join your group</p>
        </div>
      </div>
      <div class="home-btn" onclick="showScreen('screen-history')">
        <div class="icon">📋</div>
        <div>
          <h3>Round history</h3>
          <p>View past rounds and results</p>
        </div>
      </div>
    </div>
  </div>

  <!-- JOIN -->
  <div id="screen-join" class="screen">
    <span class="back-link" onclick="showScreen('screen-home')">← Back</span>
    <div class="card">
      <div class="card-title">Join a round</div>
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:1rem">Enter the 6-letter code shared by whoever started the round.</p>
      <label>Round code</label>
      <input type="text" id="join-code" class="join-code-input" maxlength="6" placeholder="ABC123" oninput="this.value=this.value.toUpperCase()" />
      <div class="mt">
        <button class="btn btn-gold btn-full" onclick="joinRound()">Join round →</button>
      </div>
    </div>
  </div>

  <!-- NEW ROUND SETUP -->
  <div id="screen-new" class="screen">
    <span class="back-link" onclick="showScreen('screen-home')">← Back</span>

    <div class="card">
      <div class="card-title">Course details</div>
      <div class="g3" style="margin-bottom:12px">
        <div><label>Course rating</label><input type="number" id="rating" step="0.1" value="72.4" /></div>
        <div><label>Slope rating</label><input type="number" id="slope" value="131" /></div>
        <div><label>Par</label><input type="number" id="par" value="72" /></div>
      </div>
      <div><label>Course name (optional)</label><input type="text" id="coursename" placeholder="e.g. Banff Springs — Rundle" /></div>
    </div>

    <div class="card">
      <div class="card-title">Game type</div>
      <select id="gametype">
        <option value="both">Skins + Match play</option>
        <option value="skins">Skins only (0.5 stroke handicap)</option>
        <option value="match">Match play only (full handicap)</option>
      </select>
    </div>

    <div class="card">
      <div class="card-title">Players</div>
      <div style="display:grid;grid-template-columns:1fr 90px 90px 36px;gap:8px;margin-bottom:6px">
        <span style="font-size:11px;color:var(--text-muted)">Name</span>
        <span style="font-size:11px;color:var(--text-muted)">Hcp index</span>
        <span style="font-size:11px;color:var(--text-muted)">Course hcp</span>
        <span></span>
      </div>
      <div id="player-rows"></div>
      <button class="btn btn-sm" onclick="addPlayer()" style="margin-top:8px">+ Add player</button>
    </div>

    <div class="card">
      <div class="card-title">Hole stroke index (from scorecard)</div>
      <div class="info-box">Enter the stroke index (1–18) for each hole as printed on the scorecard. This determines which holes players receive handicap strokes on.</div>
      <div class="hi-grid" id="hi-front"></div>
      <div class="hi-grid" id="hi-back"></div>
    </div>

    <button class="btn btn-gold btn-full" onclick="createRound()">Create round &amp; get code →</button>
  </div>

  <!-- ACTIVE ROUND -->
  <div id="screen-round" class="screen">
    <span class="back-link" onclick="showScreen('screen-home')">← Home</span>

    <div class="status-bar">
      <div class="status-dot"></div>
      <span id="round-status-text">Round active</span>
    </div>

    <div class="card" style="text-align:center">
      <div class="card-title">Share this code with your group</div>
      <div class="round-code-badge" id="display-code">——</div>
      <div class="round-code-hint">Anyone can join at this site and enter the code</div>
    </div>

    <div class="tabs">
      <div class="tab active" onclick="switchTab('scorecard')">Scorecard</div>
      <div class="tab" onclick="switchTab('results')">Results</div>
      <div class="tab" onclick="switchTab('info')">Info</div>
    </div>

    <!-- SCORECARD TAB -->
    <div id="tab-scorecard">
      <div class="card">
        <div class="card-title">Enter gross scores — <span id="stroke-summary" style="font-weight:400;text-transform:none;letter-spacing:0"></span></div>
        <div class="scorecard-wrap">
          <table id="scorecard-table"></table>
        </div>
        <div class="mt flex-end">
          <button class="btn btn-green" onclick="saveScores()">Save scores</button>
        </div>
      </div>
    </div>

    <!-- RESULTS TAB -->
    <div id="tab-results" style="display:none">
      <div id="results-content"></div>
    </div>

    <!-- INFO TAB -->
    <div id="tab-info" style="display:none">
      <div class="card">
        <div class="card-title">Round info</div>
        <div id="round-info-content"></div>
      </div>
      <button class="btn btn-sm" style="color:var(--red);border-color:var(--red)" onclick="finishRound()">Mark round as complete</button>
    </div>
  </div>

  <!-- HISTORY -->
  <div id="screen-history" class="screen">
    <span class="back-link" onclick="showScreen('screen-home')">← Back</span>
    <div class="card">
      <div class="card-title">Past rounds</div>
      <div id="history-list"><p style="color:var(--text-muted);font-size:13px">Loading...</p></div>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<!-- FIREBASE -->
