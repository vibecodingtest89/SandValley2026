<script>
// ─── STATE ───────────────────────────────────────────────────────────────────
let players = [];
let hiOrder = Array.from({length:18},(_,i)=>i+1);
let currentRoundId = null;
let currentRoundData = null;

// ─── UTILITIES ────────────────────────────────────────────────────────────────
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 'screen-history') loadHistory();
}

function toast(msg, dur=2500) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), dur);
}

function genCode() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  return Array.from({length:6}, () => chars[Math.floor(Math.random()*chars.length)]).join('');
}

function calcCourseHcp(idx, slope, rating, par) {
  return Math.round(idx * slope / 113 + (rating - par));
}

function getStrokesOnHole(courseHcp, holeHi) {
  if (courseHcp <= 0) return 0;
  return holeHi <= courseHcp ? 1 : 0;
}

function waitForDB(fn) {
  if (window._dbReady) { fn(); return; }
  const iv = setInterval(() => { if (window._dbReady) { clearInterval(iv); fn(); } }, 100);
}

// ─── PLAYER BUILDER ───────────────────────────────────────────────────────────
function addPlayer() {
  if (players.length >= 4) { toast('Maximum 4 players'); return; }
  players.push({ name: 'Player ' + (players.length + 1), idx: 10, courseHcp: 0 });
  renderPlayers();
  updateCourseHcps();
}

function removePlayer(i) {
  players.splice(i, 1);
  renderPlayers();
  updateCourseHcps();
}

function renderPlayers() {
  const cont = document.getElementById('player-rows');
  cont.innerHTML = players.map((p, i) => `
    <div class="player-item">
      <input type="text" value="${p.name}" oninput="players[${i}].name=this.value" placeholder="Player name" />
      <input type="number" step="0.1" min="0" max="54" value="${p.idx}" oninput="players[${i}].idx=parseFloat(this.value)||0;updateCourseHcps()" placeholder="Index" />
      <div class="chcp-display" id="chcp-${i}">${p.courseHcp}</div>
      ${players.length > 1 ? `<button class="remove-btn" onclick="removePlayer(${i})">✕</button>` : '<div></div>'}
    </div>
  `).join('');
}

function updateCourseHcps() {
  const slope = parseFloat(document.getElementById('slope')?.value) || 113;
  const rating = parseFloat(document.getElementById('rating')?.value) || 72;
  const par = parseFloat(document.getElementById('par')?.value) || 72;
  players.forEach((p, i) => {
    p.courseHcp = calcCourseHcp(p.idx, slope, rating, par);
    const el = document.getElementById('chcp-' + i);
    if (el) el.textContent = p.courseHcp;
  });
}

// ─── HI GRID ──────────────────────────────────────────────────────────────────
function buildHiGrid() {
  ['hi-front','hi-back'].forEach((id, half) => {
    const cont = document.getElementById(id);
    if (!cont) return;
    cont.innerHTML = '';
    for (let h = half*9; h < half*9+9; h++) {
      const d = document.createElement('div');
      d.className = 'hi-cell';
      d.innerHTML = `<label>H${h+1}</label><input type="number" min="1" max="18" value="${hiOrder[h]}" oninput="hiOrder[${h}]=parseInt(this.value)||${h+1}" />`;
      cont.appendChild(d);
    }
  });
}

// ─── CREATE ROUND ─────────────────────────────────────────────────────────────
function createRound() {
  if (players.length < 2) { toast('Add at least 2 players'); return; }
  updateCourseHcps();

  const slope = parseFloat(document.getElementById('slope').value) || 113;
  const rating = parseFloat(document.getElementById('rating').value) || 72;
  const par = parseInt(document.getElementById('par').value) || 72;
  const gameType = document.getElementById('gametype').value;
  const courseName = document.getElementById('coursename').value || 'Golf Course';
  const code = genCode();

  const roundData = {
    code,
    courseName,
    slope,
    rating,
    par,
    gameType,
    players: players.map(p => ({ name: p.name, idx: p.idx, courseHcp: p.courseHcp })),
    hiOrder: [...hiOrder],
    scores: {},
    status: 'active',
    createdAt: null
  };

  waitForDB(() => {
    const { doc, setDoc, serverTimestamp } = window._fs;
    const db = window._db;
    roundData.createdAt = serverTimestamp();
    setDoc(doc(db, 'rounds', code), roundData)
      .then(() => {
        currentRoundId = code;
        currentRoundData = roundData;
        loadRoundScreen(roundData);
        toast('Round created! Code: ' + code);
      })
      .catch(e => { console.error(e); toast('Error creating round'); });
  });
}

// ─── JOIN ROUND ───────────────────────────────────────────────────────────────
function joinRound() {
  const code = document.getElementById('join-code').value.trim().toUpperCase();
  if (code.length < 4) { toast('Enter a valid round code'); return; }

  waitForDB(() => {
    const { doc, getDoc } = window._fs;
    getDoc(doc(window._db, 'rounds', code))
      .then(snap => {
        if (!snap.exists()) { toast('Round not found'); return; }
        const data = snap.data();
        currentRoundId = code;
        currentRoundData = data;
        loadRoundScreen(data);
      })
      .catch(e => { console.error(e); toast('Error joining round'); });
  });
}

// ─── LOAD ROUND SCREEN ────────────────────────────────────────────────────────
function loadRoundScreen(data) {
  document.getElementById('display-code').textContent = data.code;
  document.getElementById('round-status-text').textContent =
    data.status === 'complete' ? 'Round complete' : 'Round active — scores sync live';
  buildRoundInfo(data);
  buildScorecard(data);
  calcResults(data);
  showScreen('screen-round');
  switchTab('scorecard');
}

function buildRoundInfo(data) {
  const el = document.getElementById('round-info-content');
  el.innerHTML = `
    <div class="g2" style="margin-bottom:12px">
      <div><label>Course</label><div style="font-size:14px;font-weight:500">${data.courseName}</div></div>
      <div><label>Game type</label><div style="font-size:14px;font-weight:500">${{both:'Skins + Match',skins:'Skins',match:'Match play'}[data.gameType]}</div></div>
      <div><label>Rating / Slope</label><div style="font-size:14px">${data.rating} / ${data.slope}</div></div>
      <div><label>Par</label><div style="font-size:14px">${data.par}</div></div>
    </div>
    <div class="divider"></div>
    <div class="card-title" style="margin-bottom:8px">Players</div>
    ${data.players.map(p => `
      <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:13px">
        <span style="font-weight:500">${p.name}</span>
        <span style="color:var(--text-muted)">Index ${p.idx} → Course hcp ${p.courseHcp}</span>
      </div>
    `).join('')}
  `;
}

// ─── SCORECARD ────────────────────────────────────────────────────────────────
function buildScorecard(data) {
  const { players: ps, hiOrder: hi, scores } = data;

  // stroke summary
  document.getElementById('stroke-summary').textContent =
    ps.map(p => `${p.name} (${p.courseHcp > 0 ? '+' : ''}${p.courseHcp} hcp)`).join(' · ');

  const table = document.getElementById('scorecard-table');
  const holeHeaders = Array.from({length:18},(_,i)=>`<th>${i+1}</th>`).join('');
  const hiRow = hi.map(h=>`<td style="font-size:10px;color:var(--text-muted)">${h}</td>`).join('');

  const playerRows = ps.map((p, pi) => {
    const cells = Array.from({length:18}, (_, h) => {
      const strokeHere = getStrokesOnHole(p.courseHcp, hi[h]);
      const saved = scores[`${pi}-${h}`] ?? '';
      return `<td>${strokeHere ? '<span class="dot"></span>' : ''}<br>
        <input type="number" min="1" max="15" id="sc-${pi}-${h}" value="${saved}" placeholder="—" />
      </td>`;
    }).join('');

    const total = Array.from({length:18}, (_, h) => {
      const v = parseInt(scores[`${pi}-${h}`]);
      return isNaN(v) ? 0 : v;
    }).reduce((a,b)=>a+b,0);

    return `<tr>
      <td>${p.name}</td>
      ${cells}
      <td id="tot-${pi}" style="font-weight:500">${total||'—'}</td>
    </tr>`;
  }).join('');

  table.innerHTML = `
    <thead>
      <tr><th>Player</th>${holeHeaders}<th>Total</th></tr>
      <tr class="stroke-row"><td style="font-size:10px;color:var(--text-muted)">Stroke index</td>${hiRow}<td></td></tr>
    </thead>
    <tbody>${playerRows}</tbody>`;

  // live totals
  table.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('input', () => updateTotals(data));
  });
}

function updateTotals(data) {
  data.players.forEach((_, pi) => {
    let sum = 0, count = 0;
    for (let h = 0; h < 18; h++) {
      const v = parseInt(document.getElementById(`sc-${pi}-${h}`)?.value);
      if (!isNaN(v)) { sum += v; count++; }
    }
    const el = document.getElementById(`tot-${pi}`);
    if (el) el.textContent = count > 0 ? sum : '—';
  });
  calcResults(data, true); // live update results
}

function saveScores() {
  if (!currentRoundId) return;
  const scores = {};
  currentRoundData.players.forEach((_, pi) => {
    for (let h = 0; h < 18; h++) {
      const v = parseInt(document.getElementById(`sc-${pi}-${h}`)?.value);
      if (!isNaN(v)) scores[`${pi}-${h}`] = v;
    }
  });
  currentRoundData.scores = scores;

  waitForDB(() => {
    const { doc, updateDoc } = window._fs;
    updateDoc(doc(window._db, 'rounds', currentRoundId), { scores })
      .then(() => toast('Scores saved ✓'))
      .catch(e => { console.error(e); toast('Save failed'); });
  });
}

// ─── RESULTS ─────────────────────────────────────────────────────────────────
function calcResults(data, silent=false) {
  const { players: ps, hiOrder: hi, gameType } = data;

  // pull live scores from inputs (or saved)
  const getScore = (pi, h) => {
    const inp = document.getElementById(`sc-${pi}-${h}`);
    const v = inp ? parseInt(inp.value) : parseInt(data.scores[`${pi}-${h}`]);
    return isNaN(v) ? null : v;
  };

  let html = '';
  if (gameType === 'skins' || gameType === 'both') html += renderSkins(ps, hi, getScore);
  if (gameType === 'match' || gameType === 'both') html += renderMatchPlay(ps, hi, getScore);

  document.getElementById('results-content').innerHTML = html || '<div class="card"><p style="color:var(--text-muted);font-size:13px">Enter scores to see results.</p></div>';
}

function renderSkins(ps, hi, getScore) {
  let carryover = 0;
  const rows = [];
  const totals = {};
  ps.forEach(p => totals[p.name] = 0);

  for (let h = 0; h < 18; h++) {
    const holeScores = ps.map((p, pi) => {
      const gross = getScore(pi, h);
      if (gross === null) return null;
      const strokes = getStrokesOnHole(p.courseHcp, hi[h]);
      return { name: p.name, gross, net: gross - strokes * 0.5, strokes };
    });

    if (holeScores.some(s => s === null)) {
      rows.push(`<tr><td>${h+1}</td><td colspan="3" style="color:var(--text-muted);font-size:12px">—</td></tr>`);
      continue;
    }

    const minNet = Math.min(...holeScores.map(s => s.net));
    const winners = holeScores.filter(s => s.net === minNet);

    if (winners.length === 1) {
      const w = winners[0];
      const skinsWon = 1 + carryover;
      totals[w.name] += skinsWon;
      rows.push(`<tr>
        <td>${h+1}</td>
        <td class="skin-winner">${w.name}</td>
        <td>${w.gross} (net ${w.net.toFixed(1)})</td>
        <td class="skin-winner">${'★'.repeat(Math.min(skinsWon,5))} ${skinsWon}</td>
      </tr>`);
      carryover = 0;
    } else {
      rows.push(`<tr>
        <td>${h+1}</td>
        <td class="skin-carry" colspan="2">Halved — carry forward</td>
        <td class="skin-carry">+${carryover+1}</td>
      </tr>`);
      carryover++;
    }
  }

  const metricsHtml = ps.map(p => `
    <div class="metric">
      <div class="metric-label">${p.name}</div>
      <div class="metric-value">${totals[p.name]}</div>
      <div class="metric-sub">skin${totals[p.name]!==1?'s':''}</div>
    </div>`).join('');

  return `<div class="card">
    <div class="card-title">Skins <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px">— 0.5 stroke handicap · natural birdie always beats net birdie</span></div>
    <div class="metrics">${metricsHtml}</div>
    <div class="scorecard-wrap">
      <table class="result-table">
        <thead><tr><th>Hole</th><th>Winner</th><th>Score</th><th>Skins</th></tr></thead>
        <tbody>${rows.join('')}</tbody>
      </table>
    </div>
    ${carryover > 0 ? `<div class="info-box" style="margin-top:12px">⚠ ${carryover} skin${carryover>1?'s':''} carried from final hole — resolve per house rules.</div>` : ''}
  </div>`;
}

function renderMatchPlay(ps, hi, getScore) {
  if (ps.length < 2) return '';
  const p0 = ps[0], p1 = ps[1];
  const hcpDiff = Math.abs(p0.courseHcp - p1.courseHcp);
  const higherIdx = p0.courseHcp > p1.courseHcp ? 0 : 1;

  let status = 0;
  const holeRows = [];
  let played = 0;

  for (let h = 0; h < 18; h++) {
    const g0 = getScore(0, h), g1 = getScore(1, h);
    if (g0 === null || g1 === null) {
      holeRows.push(`<div class="match-hole-row"><span class="p1" style="color:var(--text-muted)">—</span><span class="hole-mid">H${h+1}</span><span class="p2" style="color:var(--text-muted)">—</span></div>`);
      continue;
    }
    played++;
    let adj0 = g0, adj1 = g1;
    if (hi[h] <= hcpDiff) { if (higherIdx===0) adj0--; else adj1--; }

    let delta = adj0 < adj1 ? -1 : adj1 < adj0 ? 1 : 0;
    status += delta;

    const statusStr = status === 0 ? 'AS' : Math.abs(status) + ' ' + (status > 0 ? p1.name : p0.name).split(' ')[0];
    const w0 = delta === -1, w1 = delta === 1;

    holeRows.push(`<div class="match-hole-row">
      <span class="p1 ${w0?'win-name':''}">${g0}${adj0!==g0?'*':''} ${w0?'✓':''}</span>
      <span class="hole-mid">H${h+1} · ${statusStr}</span>
      <span class="p2 ${w1?'win-name':''}">${w1?'✓ ':''}${g1}${adj1!==g1?'*':''}</span>
    </div>`);
  }

  const remaining = 18 - played;
  const lastPlayed = played > 0;
  let matchResult = '';
  if (lastPlayed) {
    if (status === 0) matchResult = `All square after ${played} holes`;
    else {
      const leader = status > 0 ? p1.name : p0.name;
      const up = Math.abs(status);
      matchResult = up > remaining
        ? `${leader} wins ${up}&${remaining} — match over`
        : `${leader} ${up} up with ${remaining} to play`;
    }
  }

  return `<div class="card">
    <div class="card-title">Match play — ${p0.name} vs ${p1.name}</div>
    <div class="info-box">${p0.name} hcp ${p0.courseHcp} · ${p1.name} hcp ${p1.courseHcp} · ${hcpDiff > 0 ? `${ps[higherIdx].name} gets a stroke on holes ranked 1–${hcpDiff}` : 'No strokes given (equal handicap)'}</div>
    ${matchResult ? `<div style="font-size:15px;font-weight:500;padding:12px;background:var(--green);color:var(--gold);border-radius:var(--radius);margin-bottom:1rem;font-family:'Bebas Neue',sans-serif;letter-spacing:0.05em;font-size:1.3rem">${matchResult}</div>` : ''}
    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted);padding:4px 0;border-bottom:1px solid var(--border);margin-bottom:4px;font-weight:500">
      <span>${p0.name}</span><span>Hole · Status</span><span>${p1.name}</span>
    </div>
    ${holeRows.join('')}
    <p style="font-size:11px;color:var(--text-muted);margin-top:8px">* adjusted for handicap stroke</p>
  </div>`;
}

// ─── TABS ─────────────────────────────────────────────────────────────────────
function switchTab(tab) {
  const tabs = ['scorecard','results','info'];
  document.querySelectorAll('.tab').forEach((el,i) => el.classList.toggle('active', tabs[i]===tab));
  tabs.forEach(t => {
    const el = document.getElementById(`tab-${t}`);
    if (el) el.style.display = t === tab ? 'block' : 'none';
  });
}

// ─── FINISH ROUND ─────────────────────────────────────────────────────────────
function finishRound() {
  if (!currentRoundId) return;
  saveScores();
  waitForDB(() => {
    const { doc, updateDoc } = window._fs;
    updateDoc(doc(window._db, 'rounds', currentRoundId), { status: 'complete' })
      .then(() => { toast('Round marked complete'); document.getElementById('round-status-text').textContent = 'Round complete'; })
      .catch(e => console.error(e));
  });
}

// ─── HISTORY ──────────────────────────────────────────────────────────────────
function loadHistory() {
  const el = document.getElementById('history-list');
  el.innerHTML = '<p style="color:var(--text-muted);font-size:13px">Loading...</p>';
  waitForDB(() => {
    const { collection, query, orderBy, limit, getDocs } = window._fs;
    const db = window._db;
    getDocs(query(collection(db, 'rounds'), orderBy('createdAt','desc'), limit(20)))
      .then(snap => {
        if (snap.empty) { el.innerHTML = '<p style="color:var(--text-muted);font-size:13px">No rounds yet.</p>'; return; }
        el.innerHTML = snap.docs.map(d => {
          const r = d.data();
          const date = r.createdAt?.toDate ? r.createdAt.toDate().toLocaleDateString('en-CA') : 'Unknown date';
          return `<div style="padding:10px 0;border-bottom:1px solid var(--border);cursor:pointer" onclick="loadRoundByCode('${r.code}')">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-weight:500;font-size:14px">${r.courseName||'Golf Course'}</div>
                <div style="font-size:12px;color:var(--text-muted)">${r.players.map(p=>p.name).join(', ')} · ${date}</div>
              </div>
              <div style="display:flex;gap:8px;align-items:center">
                <span style="font-size:11px;background:${r.status==='complete'?'#d4edda':'#fff3cd'};color:${r.status==='complete'?'#1a5c2a':'#856404'};padding:3px 8px;border-radius:999px">${r.status==='complete'?'Complete':'Active'}</span>
                <span style="font-family:'Bebas Neue',sans-serif;color:var(--green-mid);letter-spacing:0.1em">${r.code}</span>
              </div>
            </div>
          </div>`;
        }).join('');
      })
      .catch(e => { console.error(e); el.innerHTML = '<p style="color:var(--text-muted);font-size:13px">Could not load history.</p>'; });
  });
}

function loadRoundByCode(code) {
  waitForDB(() => {
    const { doc, getDoc } = window._fs;
    getDoc(doc(window._db, 'rounds', code))
      .then(snap => {
        if (!snap.exists()) { toast('Round not found'); return; }
        currentRoundId = code;
        currentRoundData = snap.data();
        loadRoundScreen(currentRoundData);
      });
  });
}

// ─── INIT ─────────────────────────────────────────────────────────────────────
window.showScreen = showScreen;
window.addPlayer = addPlayer;
window.removePlayer = removePlayer;
window.updateCourseHcps = updateCourseHcps;
window.createRound = createRound;
window.joinRound = joinRound;
window.saveScores = saveScores;
window.switchTab = switchTab;
window.finishRound = finishRound;
window.loadRoundByCode = loadRoundByCode;

addPlayer();
addPlayer();
buildHiGrid();
</script>
